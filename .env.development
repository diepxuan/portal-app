# API Portal — môi trường DEV (npx expo start, expo start --tunnel)
#
# Dùng trong lúc phát triển trên máy dev và test qua Expo Go.
# Domain dev KHÔNG dùng cho bản phát hành.
#
# Path /api/v1 đã Bypass trên Cloudflare cho cả 2 domain (kiểm chứng 2026-11-28):
#   GET /api/v1/SoPh3 → 401  (vào tới Laravel, Sanctum đang chạy)
#   GET /api/v1       → 404  (route chưa có, response từ Laravel)
EXPO_PUBLIC_API_BASE_URL=https://portaldev.diepxuan.io.vn/api/v1
